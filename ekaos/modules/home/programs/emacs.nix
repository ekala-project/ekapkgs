# Per-user Emacs editor configuration
#
# Extends home.users.<name> with Emacs options, optional daemon
# systemd service, and package management via emacsWithPackages.
#
# Usage:
#   home.users.alice.programs.emacs = {
#     enable = true;
#     defaultEditor = true;
#     enableDaemon = true;
#     extraPackages = epkgs: [
#       epkgs.magit
#       epkgs.use-package
#       epkgs.evil
#       epkgs.which-key
#     ];
#     extraConfig = ''
#       (require 'use-package)
#       (use-package evil
#         :config
#         (evil-mode 1))
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    literalExpression
    ;

  emacsOpts =
    { config, ... }:
    let
      cfg = config.programs.emacs;

      # Build the final emacs package, wrapping with extra packages if provided
      emacsPackage =
        let
          testPkgs = cfg.extraPackages (pkgs.emacsPackagesFor cfg.package);
        in
        if testPkgs != [ ] then
          (pkgs.emacsPackagesFor cfg.package).emacsWithPackages cfg.extraPackages
        else
          cfg.package;

      defaultElContent = ";; Generated by ekaos home configuration. Do not edit.\n${cfg.extraConfig}";
    in
    {
      options.programs.emacs = {
        enable = mkEnableOption "per-user Emacs configuration";

        package = mkOption {
          type = types.package;
          default = pkgs.emacs;
          description = "Base Emacs package to install.";
        };

        defaultEditor = mkOption {
          type = types.bool;
          default = false;
          description = ''
            Whether to set EDITOR to `emacsclient -t`.
            Adds the variable to the user's session environment.
          '';
        };

        enableDaemon = mkOption {
          type = types.bool;
          default = false;
          description = ''
            Whether to run Emacs as a user daemon via a systemd user service.
            When enabled, a systemd unit `emacs.service` is created that
            starts `emacs --fg-daemon`.
          '';
        };

        extraPackages = mkOption {
          type = types.functionTo (types.listOf types.package);
          default = _: [ ];
          defaultText = literalExpression "_: [ ]";
          example = literalExpression ''
            epkgs: [
              epkgs.magit
              epkgs.use-package
              epkgs.evil
            ]
          '';
          description = ''
            Function that takes an emacs package set and returns a list
            of packages to include. When non-empty, the installed Emacs
            is wrapped with these packages via emacsWithPackages.
          '';
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          example = ''
            (require 'use-package)
            (setq use-package-always-ensure nil)
          '';
          description = ''
            Extra Emacs Lisp code written to ~/.config/emacs/default.el.
            This file is loaded automatically by Emacs at startup.
          '';
        };
      };

      config = mkIf cfg.enable {
        packages = [ emacsPackage ];

        file.".config/emacs/default.el" = mkIf (cfg.extraConfig != "") {
          text = defaultElContent;
        };

        sessionVariables = mkIf cfg.defaultEditor {
          EDITOR = "emacsclient -t";
        };

        file.".config/systemd/user/emacs.service" = mkIf cfg.enableDaemon {
          text = ''
            [Unit]
            Description=Emacs text editor (daemon)
            Documentation=info:emacs man:emacs(1) https://gnu.org/software/emacs/

            [Service]
            Type=notify
            ExecStart=${emacsPackage}/bin/emacs --fg-daemon
            ExecStop=${emacsPackage}/bin/emacsclient --eval "(kill-emacs)"
            Restart=on-failure

            [Install]
            WantedBy=default.target
          '';
        };
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule emacsOpts);
  };
}
