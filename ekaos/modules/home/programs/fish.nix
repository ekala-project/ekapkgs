# Per-user fish shell configuration
#
# Extends home.users.<name> with fish-specific options and composes
# ~/.config/fish/config.fish from session variables, abbreviations,
# plugins, custom functions, and user init snippets.
#
# Usage:
#   home.users.alice.programs.fish = {
#     enable = true;
#     shellAbbrs = {
#       gs = "git status";
#       ga = "git add";
#     };
#     plugins = [
#       {
#         name = "z";
#         src = pkgs.fetchFromGitHub {
#           owner = "jethrokuan";
#           repo = "z";
#           rev = "...";
#           hash = "sha256-...";
#         };
#       }
#     ];
#     functions = {
#       fish_greeting = "echo 'Welcome back!'";
#       mkcd = {
#         body = "mkdir -p $argv[1]; and cd $argv[1]";
#         description = "Create a directory and cd into it";
#       };
#     };
#     interactiveShellInit = ''
#       eval (direnv hook fish)
#       set -g fish_color_command green
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    concatStringsSep
    concatMapStringsSep
    mapAttrsToList
    escapeShellArg
    optional
    optionalString
    literalExpression
    ;

  # Submodule for fish functions that have a body and optional description
  fishFunctionOpts = {
    options = {
      body = mkOption {
        type = types.lines;
        description = "The function body.";
      };

      description = mkOption {
        type = types.str;
        default = "";
        description = "Optional description for the function.";
      };
    };
  };

  # Render a single fish function file
  renderFunctionFile =
    name: def:
    let
      isStructured = builtins.isAttrs def;
      body = if isStructured then def.body else def;
      description = if isStructured then def.description else "";
      descFlag = optionalString (description != "") " --description ${escapeShellArg description}";
    in
    concatStringsSep "\n" [
      "# Generated by ekaos home configuration. Do not edit."
      "function ${name}${descFlag}"
      "    ${body}"
      "end"
      ""
    ];

  fishOpts =
    { config, ... }:
    let
      cfg = config.programs.fish;

      # Re-export sessionVariables as fish set -gx commands
      fishSessionVars = concatStringsSep "\n" (
        mapAttrsToList (
          name: value: "set -gx ${name} ${escapeShellArg (toString value)}"
        ) config.sessionVariables
      );

      # Re-export sessionPath by prepending to fish_user_paths
      fishSessionPath =
        if config.sessionPath != [ ] then
          let
            # Include ekaos profile bin if the user has packages
            allPaths = (optional (config.packages != [ ]) "$HOME/.ekaos-profile/bin") ++ config.sessionPath;
          in
          "set -gx fish_user_paths ${concatStringsSep " " allPaths} $fish_user_paths"
        else if config.packages != [ ] then
          "set -gx fish_user_paths $HOME/.ekaos-profile/bin $fish_user_paths"
        else
          "";

      # Re-export shellAliases as fish alias commands
      fishShellAliases = concatStringsSep "\n" (
        mapAttrsToList (name: value: "alias ${name} ${escapeShellArg value}") config.shellAliases
      );

      # Abbreviation definitions
      fishAbbrs = concatStringsSep "\n" (
        mapAttrsToList (name: value: "    abbr -a -- ${name} ${escapeShellArg value}") cfg.shellAbbrs
      );

      # Plugin loading: source init.fish and conf.d/*.fish from each plugin
      fishPlugins = concatMapStringsSep "\n" (
        plugin:
        concatStringsSep "\n" [
          "    # Plugin: ${plugin.name}"
          "    if test -f ${plugin.src}/init.fish"
          "        source ${plugin.src}/init.fish"
          "    end"
          "    if test -d ${plugin.src}/conf.d"
          "        for f in ${plugin.src}/conf.d/*.fish"
          "            source $f"
          "        end"
          "    end"
          "    if test -d ${plugin.src}/functions"
          "        set -p fish_function_path ${plugin.src}/functions"
          "    end"
        ]
      ) cfg.plugins;

      # Compose the config.fish from all parts
      configFishContent = concatStringsSep "\n" (
        [ "# Generated by ekaos home configuration. Do not edit." ]
        ++ [ "" ]

        # Session variables (fish-native re-export)
        ++ optional (config.sessionVariables != { }) "# Session variables"
        ++ optional (config.sessionVariables != { }) fishSessionVars

        # Session path
        ++ optional (fishSessionPath != "") ""
        ++ optional (fishSessionPath != "") "# Session path"
        ++ optional (fishSessionPath != "") fishSessionPath

        # Shell aliases
        ++ optional (config.shellAliases != { }) ""
        ++ optional (config.shellAliases != { }) "# Shell aliases"
        ++ optional (config.shellAliases != { }) fishShellAliases

        # shellInit (all shell instances)
        ++ optional (cfg.shellInit != "") ""
        ++ optional (cfg.shellInit != "") "# Shell init (all instances)"
        ++ optional (cfg.shellInit != "") cfg.shellInit

        # Everything below is interactive-only
        ++ [
          ""
          "if status is-interactive"
        ]

        # Abbreviations
        ++ optional (cfg.shellAbbrs != { }) "    # Abbreviations"
        ++ optional (cfg.shellAbbrs != { }) fishAbbrs

        # Plugins
        ++ optional (cfg.plugins != [ ]) "    # Plugins"
        ++ optional (cfg.plugins != [ ]) fishPlugins

        # Login shell init
        ++ optional (cfg.loginShellInit != "") "    if status is-login"
        ++ optional (cfg.loginShellInit != "") cfg.loginShellInit
        ++ optional (cfg.loginShellInit != "") "    end"

        # Interactive shell init (user-provided)
        ++ optional (cfg.interactiveShellInit != "") ""
        ++ optional (cfg.interactiveShellInit != "") cfg.interactiveShellInit

        ++ [ "end" ]
      );

      # Build custom function files
      functionFiles = mapAttrsToList (name: def: {
        path = ".config/fish/functions/${name}.fish";
        content = renderFunctionFile name def;
      }) cfg.functions;
    in
    {
      options.programs.fish = {
        enable = mkEnableOption "per-user fish shell configuration";

        package = mkOption {
          type = types.package;
          default = pkgs.fish;
          description = "Fish package to install.";
        };

        interactiveShellInit = mkOption {
          type = types.lines;
          default = "";
          example = ''
            eval (direnv hook fish)
            set -g fish_color_command green
          '';
          description = ''
            Extra commands to run in interactive fish shells.
            Appended inside the `if status is-interactive` block
            in config.fish.
          '';
        };

        loginShellInit = mkOption {
          type = types.lines;
          default = "";
          example = ''
            set -gx GPG_TTY (tty)
          '';
          description = ''
            Extra commands for login shells. Placed inside a
            `if status is-login` block within the interactive section.
          '';
        };

        shellInit = mkOption {
          type = types.lines;
          default = "";
          example = ''
            set -gx EDITOR vim
          '';
          description = ''
            Extra commands for all fish shell instances (interactive
            and non-interactive). Placed before the interactive block.
          '';
        };

        shellAbbrs = mkOption {
          type = types.attrsOf types.str;
          default = { };
          example = literalExpression ''
            {
              gs = "git status";
              ga = "git add";
              gc = "git commit";
            }
          '';
          description = "Fish abbreviations. Expanded inline when typed.";
        };

        plugins = mkOption {
          type = types.listOf (types.attrsOf types.anything);
          default = [ ];
          example = literalExpression ''
            [
              {
                name = "z";
                src = pkgs.fetchFromGitHub {
                  owner = "jethrokuan";
                  repo = "z";
                  rev = "...";
                  hash = "sha256-...";
                };
              }
            ]
          '';
          description = ''
            Fish plugin specifications. Each entry should have a
            `name` and `src` attribute. The plugin's init.fish,
            conf.d/*.fish, and functions/ directory are loaded
            automatically.
          '';
        };

        functions = mkOption {
          type = types.attrsOf (types.either types.str (types.submodule fishFunctionOpts));
          default = { };
          example = literalExpression ''
            {
              fish_greeting = "echo 'Welcome back!'";
              mkcd = {
                body = "mkdir -p $argv[1]; and cd $argv[1]";
                description = "Create a directory and cd into it";
              };
            }
          '';
          description = ''
            Custom fish functions. Each entry is either a string (the
            function body) or an attrset with `body` and optional
            `description`. Written to ~/.config/fish/functions/<name>.fish.
          '';
        };
      };

      config = mkIf cfg.enable {
        packages = [ cfg.package ];

        file = {
          ".config/fish/config.fish".text = configFishContent;
        }
        // builtins.listToAttrs (
          map (f: {
            name = f.path;
            value = {
              text = f.content;
            };
          }) functionFiles
        );
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule fishOpts);
  };
}
