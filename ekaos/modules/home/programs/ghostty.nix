# Per-user Ghostty terminal configuration
#
# Extends home.users.<name> with Ghostty-specific options.
# Generates ~/.config/ghostty/config from settings and extraConfig.
#
# Usage:
#   home.users.alice.programs.ghostty = {
#     enable = true;
#     settings = {
#       font-family = "JetBrains Mono";
#       font-size = 12;
#       theme = "catppuccin-mocha";
#       window-decoration = false;
#       scrollback-limit = 10000;
#     };
#     extraConfig = ''
#       keybind = ctrl+shift+t=new_tab
#       keybind = ctrl+shift+n=new_window
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    concatStringsSep
    mapAttrsToList
    literalExpression
    ;

  # Convert a Nix value to Ghostty config format
  ghosttyValue = v: if builtins.isBool v then (if v then "true" else "false") else toString v;

  ghosttyOpts =
    { config, ... }:
    let
      cfg = config.programs.ghostty;

      ghosttyConfigContent =
        "# Generated by ekaos home configuration. Do not edit.\n"
        + concatStringsSep "\n" (
          mapAttrsToList (name: value: "${name} = ${ghosttyValue value}") cfg.settings
        )
        + (if cfg.settings != { } then "\n" else "")
        + (if cfg.extraConfig != "" then "\n${cfg.extraConfig}\n" else "");
    in
    {
      options.programs.ghostty = {
        enable = mkEnableOption "per-user Ghostty terminal configuration";

        package = mkOption {
          type = types.package;
          default = pkgs.ghostty;
          description = "Ghostty package to install.";
        };

        settings = mkOption {
          type = types.attrsOf types.anything;
          default = { };
          example = literalExpression ''
            {
              font-family = "JetBrains Mono";
              font-size = 12;
              theme = "catppuccin-mocha";
              window-decoration = false;
              scrollback-limit = 10000;
            }
          '';
          description = ''
            Ghostty configuration as attribute set.
            Each key-value pair is rendered as `key = value` in the config file.
            Booleans are converted to "true"/"false".
          '';
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          example = ''
            keybind = ctrl+shift+t=new_tab
            keybind = ctrl+shift+n=new_window
          '';
          description = ''
            Extra configuration appended verbatim to the Ghostty config
            after the generated settings.
          '';
        };
      };

      config = mkIf cfg.enable {
        packages = [ cfg.package ];

        file.".config/ghostty/config".text = ghosttyConfigContent;
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule ghosttyOpts);
  };
}
