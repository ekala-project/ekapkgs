# Per-user kitty terminal configuration
#
# Extends home.users.<name> with kitty-specific options.
# Generates ~/.config/kitty/kitty.conf from settings and extraConfig.
#
# Usage:
#   home.users.alice.programs.kitty = {
#     enable = true;
#     settings = {
#       font_family = "JetBrains Mono";
#       font_size = 12;
#       scrollback_lines = 10000;
#       enable_audio_bell = false;
#       background_opacity = "0.95";
#     };
#     extraConfig = ''
#       map ctrl+shift+t new_tab
#       map ctrl+shift+n new_window
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    concatStringsSep
    mapAttrsToList
    literalExpression
    ;

  # Convert a Nix value to kitty.conf format
  kittyValue = v: if builtins.isBool v then (if v then "yes" else "no") else toString v;

  kittyOpts =
    { config, ... }:
    let
      cfg = config.programs.kitty;

      kittyConfContent =
        "# Generated by ekaos home configuration. Do not edit.\n"
        + concatStringsSep "\n" (mapAttrsToList (name: value: "${name} ${kittyValue value}") cfg.settings)
        + (if cfg.settings != { } then "\n" else "")
        + (if cfg.extraConfig != "" then "\n${cfg.extraConfig}\n" else "");
    in
    {
      options.programs.kitty = {
        enable = mkEnableOption "per-user kitty terminal configuration";

        package = mkOption {
          type = types.package;
          default = pkgs.kitty;
          description = "Kitty package to install.";
        };

        settings = mkOption {
          type = types.attrsOf types.anything;
          default = { };
          example = literalExpression ''
            {
              font_family = "JetBrains Mono";
              font_size = 12;
              scrollback_lines = 10000;
              enable_audio_bell = false;
            }
          '';
          description = ''
            Kitty configuration as attribute set.
            Each key-value pair is rendered as `key value` in kitty.conf.
            Booleans are converted to "yes"/"no".
          '';
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          example = ''
            map ctrl+shift+t new_tab
            map ctrl+shift+n new_window
          '';
          description = ''
            Extra configuration appended verbatim to kitty.conf
            after the generated settings.
          '';
        };
      };

      config = mkIf cfg.enable {
        packages = [ cfg.package ];

        file.".config/kitty/kitty.conf".text = kittyConfContent;
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule kittyOpts);
  };
}
