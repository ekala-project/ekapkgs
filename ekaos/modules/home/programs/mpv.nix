# Per-user mpv media player configuration
#
# Extends home.users.<name> with mpv-specific options.
# Generates ~/.config/mpv/mpv.conf, ~/.config/mpv/input.conf,
# and loads user-specified scripts.
#
# Usage:
#   home.users.alice.programs.mpv = {
#     enable = true;
#     settings = {
#       vo = "gpu";
#       hwdec = "auto-safe";
#       keep-open = true;
#       volume = 80;
#     };
#     bindings = {
#       "l" = "seek 5";
#       "h" = "seek -5";
#       "Shift+RIGHT" = "seek 60";
#     };
#     profiles = {
#       "low-quality" = {
#         vo = "gpu";
#         scale = "bilinear";
#       };
#     };
#     scripts = [ pkgs.mpvScripts.uosc pkgs.mpvScripts.thumbfast ];
#     extraConfig = ''
#       # Additional mpv configuration
#       osd-font-size=32
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    concatStringsSep
    concatMap
    mapAttrsToList
    optional
    literalExpression
    ;

  # Convert a Nix value to mpv.conf format
  mpvValue = v: if builtins.isBool v then (if v then "yes" else "no") else toString v;

  mpvOpts =
    { config, ... }:
    let
      cfg = config.programs.mpv;

      # Build mpv.conf content
      mpvConfContent = concatStringsSep "\n" (
        [ "# Generated by ekaos home configuration. Do not edit." ]
        ++ [ "" ]

        # Global settings
        ++ mapAttrsToList (name: value: "${name}=${mpvValue value}") cfg.settings

        # Script loading
        ++ map (script: "script=${script}/share/mpv/scripts") cfg.scripts

        # Profile sections
        ++ concatMap (
          name:
          let
            profileSettings = cfg.profiles.${name};
          in
          [
            ""
            "[${name}]"
          ]
          ++ mapAttrsToList (k: v: "${k}=${mpvValue v}") profileSettings
        ) (builtins.attrNames cfg.profiles)

        # Extra configuration
        ++ optional (cfg.extraConfig != "") ""
        ++ optional (cfg.extraConfig != "") cfg.extraConfig
      );

      # Build input.conf content
      inputConfContent = concatStringsSep "\n" (
        [ "# Generated by ekaos home configuration. Do not edit." ]
        ++ [ "" ]
        ++ mapAttrsToList (key: command: "${key} ${command}") cfg.bindings
      );

      hasBindings = cfg.bindings != { };
    in
    {
      options.programs.mpv = {
        enable = mkEnableOption "per-user mpv configuration";

        package = mkOption {
          type = types.package;
          default = pkgs.mpv;
          description = "mpv package to install.";
        };

        settings = mkOption {
          type = types.attrsOf types.anything;
          default = { };
          example = literalExpression ''
            {
              vo = "gpu";
              hwdec = "auto-safe";
              keep-open = true;
              volume = 80;
            }
          '';
          description = ''
            mpv configuration as attribute set.
            Each key-value pair is rendered as `key=value` in mpv.conf.
            Booleans are converted to "yes"/"no".
          '';
        };

        bindings = mkOption {
          type = types.attrsOf types.str;
          default = { };
          example = literalExpression ''
            {
              "l" = "seek 5";
              "h" = "seek -5";
              "Shift+RIGHT" = "seek 60";
            }
          '';
          description = ''
            Key bindings for mpv.
            Each key-value pair is rendered as `KEY command` in input.conf.
          '';
        };

        scripts = mkOption {
          type = types.listOf types.package;
          default = [ ];
          example = literalExpression "[ pkgs.mpvScripts.uosc pkgs.mpvScripts.thumbfast ]";
          description = "List of mpv script packages to load.";
        };

        profiles = mkOption {
          type = types.attrsOf (types.attrsOf types.anything);
          default = { };
          example = literalExpression ''
            {
              "low-quality" = {
                vo = "gpu";
                scale = "bilinear";
              };
            }
          '';
          description = ''
            mpv profiles as nested attribute sets.
            Each top-level key becomes a `[profile]` section in mpv.conf.
          '';
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          description = "Extra lines appended verbatim to mpv.conf.";
        };
      };

      config = mkIf cfg.enable {
        packages = [ cfg.package ];

        file.".config/mpv/mpv.conf".text = mpvConfContent;
        file.".config/mpv/input.conf" = mkIf hasBindings {
          text = inputConfContent;
        };
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule mpvOpts);
  };
}
