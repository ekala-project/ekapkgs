# Per-user neomutt email client configuration
#
# Extends home.users.<name> with neomutt-specific options.
# Generates ~/.config/neomutt/neomuttrc from settings, bindings,
# and extra configuration.
#
# Usage:
#   home.users.alice.programs.neomutt = {
#     enable = true;
#     settings = {
#       sort = "threads";
#       sort_aux = "reverse-last-date-received";
#       mailcap_path = "~/.config/neomutt/mailcap";
#       sidebar_visible = "yes";
#       sidebar_width = "30";
#     };
#     bindings = [
#       { map = "index"; key = "G"; action = "last-entry"; }
#       { map = "index"; key = "gg"; action = "first-entry"; }
#       { map = "pager"; key = "j"; action = "next-line"; }
#       { map = "pager"; key = "k"; action = "previous-line"; }
#     ];
#     extraConfig = ''
#       source ~/.config/neomutt/accounts/personal
#       color status cyan default
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    concatStringsSep
    mapAttrsToList
    optional
    literalExpression
    ;

  bindingSubmodule = types.submodule {
    options = {
      map = mkOption {
        type = types.str;
        example = "index";
        description = "The map context for the binding (e.g. index, pager, browser).";
      };
      key = mkOption {
        type = types.str;
        example = "G";
        description = "The key to bind.";
      };
      action = mkOption {
        type = types.str;
        example = "last-entry";
        description = "The neomutt function or macro to execute.";
      };
    };
  };

  neomuttOpts =
    { config, ... }:
    let
      cfg = config.programs.neomutt;

      neomuttConfContent = concatStringsSep "\n" (
        [ "# Generated by ekaos home configuration. Do not edit." ]
        ++ [ "" ]

        # Settings: set key=value
        ++ mapAttrsToList (name: value: "set ${name}=${value}") cfg.settings

        # Bindings: bind map key action
        ++ optional (cfg.settings != { } && cfg.bindings != [ ]) ""
        ++ map (b: "bind ${b.map} ${b.key} ${b.action}") cfg.bindings

        # Extra configuration
        ++ optional (cfg.extraConfig != "") ""
        ++ optional (cfg.extraConfig != "") cfg.extraConfig
      );
    in
    {
      options.programs.neomutt = {
        enable = mkEnableOption "per-user neomutt configuration";

        package = mkOption {
          type = types.package;
          default = pkgs.neomutt;
          description = "Neomutt package to install.";
        };

        settings = mkOption {
          type = types.attrsOf types.str;
          default = { };
          example = literalExpression ''
            {
              sort = "threads";
              sort_aux = "reverse-last-date-received";
              sidebar_visible = "yes";
            }
          '';
          description = ''
            Neomutt settings as attribute set.
            Each key-value pair is rendered as `set key=value` in neomuttrc.
          '';
        };

        bindings = mkOption {
          type = types.listOf bindingSubmodule;
          default = [ ];
          example = literalExpression ''
            [
              { map = "index"; key = "G"; action = "last-entry"; }
              { map = "index"; key = "gg"; action = "first-entry"; }
              { map = "pager"; key = "j"; action = "next-line"; }
            ]
          '';
          description = ''
            Key bindings for neomutt.
            Each entry is rendered as `bind map key action` in neomuttrc.
          '';
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          description = "Extra lines appended verbatim to neomuttrc.";
        };
      };

      config = mkIf cfg.enable {
        packages = [ cfg.package ];

        file.".config/neomutt/neomuttrc".text = neomuttConfContent;
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule neomuttOpts);
  };
}
