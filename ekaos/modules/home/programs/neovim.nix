# Per-user Neovim configuration
#
# Extends home.users.<name> with neovim options: plugins, extraConfig,
# extraPackages, CoC settings, and editor aliases.
#
# Plugins are wrapped into the neovim package via --cmd "set rtp^=..."
# so they resolve to store paths without manual symlinking.
#
# Usage:
#   home.users.alice.programs.neovim = {
#     enable = true;
#     defaultEditor = true;
#     viAlias = true;
#     vimAlias = true;
#     plugins = [ pkgs.vimPlugins.fzf-vim pkgs.vimPlugins.lightline-vim ];
#     extraConfig = ''
#       set number
#       colorscheme desert
#     '';
#     coc = {
#       enable = true;
#       settings = {
#         "rust-analyzer.server.path" = "rust-analyzer";
#         "languageserver"."nix" = {
#           command = "nil";
#           filetypes = [ "nix" ];
#         };
#       };
#     };
#     extraPackages = [ pkgs.nil pkgs.rust-analyzer ];
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    mkMerge
    types
    concatStringsSep
    concatMapStringsSep
    optional
    optionalString
    literalExpression
    ;

  neovimOpts =
    { config, ... }:
    let
      cfg = config.programs.neovim;

      # Build the wrapped neovim with plugins on the runtime path
      pluginRtp = concatMapStringsSep "," (p: "${p}") cfg.plugins;

      wrappedNeovim = pkgs.runCommand "neovim-wrapped" {
        nativeBuildInputs = [ pkgs.makeWrapper ];
        meta.mainProgram = "nvim";
      } (
        ''
          mkdir -p $out/bin
          makeWrapper ${cfg.package}/bin/nvim $out/bin/nvim \
        ''
        + optionalString (cfg.plugins != [ ]) ''
          --add-flags '--cmd "set rtp^=${pluginRtp}"' \
        ''
        + optionalString (cfg.extraPackages != [ ]) ''
          --prefix PATH : ${lib.makeBinPath cfg.extraPackages} \
        ''
        + ''
          --set-default EDITOR nvim
        ''
      );
    in
    {
      options.programs.neovim = {
        enable = mkEnableOption "per-user Neovim configuration";

        package = mkOption {
          type = types.package;
          default = pkgs.neovim-unwrapped;
          description = "Neovim unwrapped package to use.";
        };

        defaultEditor = mkOption {
          type = types.bool;
          default = false;
          description = "Whether to set Neovim as the default EDITOR.";
        };

        viAlias = mkOption {
          type = types.bool;
          default = false;
          description = "Whether to alias vi to nvim.";
        };

        vimAlias = mkOption {
          type = types.bool;
          default = false;
          description = "Whether to alias vim to nvim.";
        };

        plugins = mkOption {
          type = types.listOf types.package;
          default = [ ];
          example = literalExpression "[ pkgs.vimPlugins.fzf-vim pkgs.vimPlugins.lightline-vim ]";
          description = ''
            Vim/Neovim plugin packages to add to the runtime path.
            These are typically from pkgs.vimPlugins.
          '';
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          example = ''
            set number
            set relativenumber
            colorscheme desert
          '';
          description = ''
            Extra vimscript configuration written to
            ~/.config/nvim/init.vim.
          '';
        };

        extraLuaConfig = mkOption {
          type = types.lines;
          default = "";
          description = ''
            Extra Lua configuration appended to init.vim via
            lua << EOF ... EOF block.
          '';
        };

        coc = {
          enable = mkEnableOption "coc.nvim integration";

          settings = mkOption {
            type = types.attrsOf types.anything;
            default = { };
            example = literalExpression ''
              {
                "rust-analyzer.server.path" = "rust-analyzer";
                "languageserver"."nix" = {
                  command = "nil";
                  filetypes = [ "nix" ];
                };
              }
            '';
            description = "CoC settings written to ~/.config/nvim/coc-settings.json.";
          };
        };

        extraPackages = mkOption {
          type = types.listOf types.package;
          default = [ ];
          example = literalExpression "[ pkgs.nil pkgs.rust-analyzer ]";
          description = "Extra packages available on PATH inside Neovim (LSPs, formatters, etc.).";
        };
      };

      config = mkIf cfg.enable (mkMerge [
        {
          packages = [ wrappedNeovim ];

          file.".config/nvim/init.vim".text = concatStringsSep "\n" (
            [ "\" Generated by ekaos home configuration. Do not edit." ]
            ++ optional (cfg.extraConfig != "") cfg.extraConfig
            ++ optional (cfg.extraLuaConfig != "") ''

              lua << EOF
              ${cfg.extraLuaConfig}
              EOF
            ''
          );
        }

        (mkIf cfg.defaultEditor {
          sessionVariables.EDITOR = "nvim";
        })

        (mkIf cfg.viAlias {
          shellAliases.vi = "nvim";
        })

        (mkIf cfg.vimAlias {
          shellAliases.vim = "nvim";
        })

        (mkIf (cfg.coc.enable && cfg.coc.settings != { }) {
          file.".config/nvim/coc-settings.json".text =
            builtins.toJSON cfg.coc.settings;
        })
      ]);
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule neovimOpts);
  };
}
