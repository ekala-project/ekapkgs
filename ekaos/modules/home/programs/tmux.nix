# Per-user tmux configuration
#
# Extends home.users.<name> with tmux-specific options and generates
# ~/.config/tmux/tmux.conf from prefix, keybindings, plugins, and
# extra configuration lines.
#
# Usage:
#   home.users.alice.programs.tmux = {
#     enable = true;
#     prefix = "C-a";
#     baseIndex = 1;
#     mouse = true;
#     keyMode = "vi";
#     historyLimit = 10000;
#     terminal = "tmux-256color";
#     plugins = [ pkgs.tmuxPlugins.resurrect pkgs.tmuxPlugins.sensible ];
#     extraConfig = ''
#       bind | split-window -h
#       bind - split-window -v
#       set -g status-style "bg=black,fg=white"
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    concatStringsSep
    optional
    optionalString
    literalExpression
    ;

  tmuxOpts =
    { config, ... }:
    let
      cfg = config.programs.tmux;

      # Build the tmux.conf content
      tmuxconfContent = concatStringsSep "\n" (
        [ "# Generated by ekaos home configuration. Do not edit." ]
        ++ [ "" ]

        # Core settings
        ++ [ "set -g default-terminal \"${cfg.terminal}\"" ]
        ++ [ "set -g prefix ${cfg.prefix}" ]
        ++ [ "set -g base-index ${toString cfg.baseIndex}" ]
        ++ [ "set -sg escape-time ${toString cfg.escapeTime}" ]
        ++ [ "set -g history-limit ${toString cfg.historyLimit}" ]
        ++ [ "set -g mouse ${if cfg.mouse then "on" else "off"}" ]
        ++ [ "set -g mode-keys ${cfg.keyMode}" ]
        ++ optional (cfg.shell != null) "set -g default-shell \"${cfg.shell}\""

        # Plugin loading
        ++ [ "" ]
        ++ map (
          plugin: "run-shell ${plugin.rtp or "${plugin}/share/tmux-plugins/*/plugin.tmux"}"
        ) cfg.plugins

        # Extra user configuration
        ++ optional (cfg.extraConfig != "") ""
        ++ optional (cfg.extraConfig != "") cfg.extraConfig
      );
    in
    {
      options.programs.tmux = {
        enable = mkEnableOption "per-user tmux configuration";

        package = mkOption {
          type = types.package;
          default = pkgs.tmux;
          description = "Tmux package to install.";
        };

        terminal = mkOption {
          type = types.str;
          default = "screen-256color";
          example = "tmux-256color";
          description = "Value for the default-terminal setting.";
        };

        prefix = mkOption {
          type = types.str;
          default = "C-b";
          example = "C-a";
          description = "Prefix key for tmux commands.";
        };

        baseIndex = mkOption {
          type = types.int;
          default = 0;
          example = 1;
          description = "Base index for numbering windows.";
        };

        escapeTime = mkOption {
          type = types.int;
          default = 500;
          example = 0;
          description = "Time in milliseconds tmux waits after an escape key.";
        };

        historyLimit = mkOption {
          type = types.int;
          default = 2000;
          example = 10000;
          description = "Maximum number of lines held in scrollback history.";
        };

        mouse = mkOption {
          type = types.bool;
          default = false;
          description = "Whether to enable mouse support.";
        };

        keyMode = mkOption {
          type = types.enum [
            "emacs"
            "vi"
          ];
          default = "emacs";
          description = "Key binding mode for copy mode and status line.";
        };

        shell = mkOption {
          type = types.nullOr types.str;
          default = null;
          example = "/run/current-system/sw/bin/zsh";
          description = "Default shell for new windows. Null uses the system default.";
        };

        plugins = mkOption {
          type = types.listOf types.package;
          default = [ ];
          example = literalExpression "[ pkgs.tmuxPlugins.resurrect pkgs.tmuxPlugins.sensible ]";
          description = "List of tmux plugin packages to load.";
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          example = ''
            bind | split-window -h
            bind - split-window -v
          '';
          description = ''
            Extra lines appended to the end of tmux.conf.
          '';
        };
      };

      config = mkIf cfg.enable {
        packages = [ cfg.package ];
        file.".config/tmux/tmux.conf".text = tmuxconfContent;
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule tmuxOpts);
  };
}
