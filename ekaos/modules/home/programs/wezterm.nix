# Per-user wezterm terminal emulator configuration
#
# Extends home.users.<name> with wezterm-specific options.
# Generates ~/.config/wezterm/wezterm.lua with a basic Lua config
# wrapper and user-provided Lua code.
#
# Usage:
#   home.users.alice.programs.wezterm = {
#     enable = true;
#     extraConfig = ''
#       config.font = wezterm.font("JetBrains Mono")
#       config.font_size = 12.0
#       config.color_scheme = "Catppuccin Mocha"
#       config.hide_tab_bar_if_only_one_tab = true
#       config.window_padding = { left = 4, right = 4, top = 4, bottom = 4 }
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    concatStringsSep
    optional
    ;

  weztermOpts =
    { config, ... }:
    let
      cfg = config.programs.wezterm;

      weztermLuaContent = concatStringsSep "\n" (
        [
          "-- Generated by ekaos home configuration. Do not edit."
          "local wezterm = require(\"wezterm\")"
          "local config = {}"
          ""
          "if wezterm.config_builder then"
          "  config = wezterm.config_builder()"
          "end"
        ]
        ++ optional (cfg.extraConfig != "") ""
        ++ optional (cfg.extraConfig != "") cfg.extraConfig
        ++ [
          ""
          "return config"
        ]
      );
    in
    {
      options.programs.wezterm = {
        enable = mkEnableOption "per-user wezterm configuration";

        package = mkOption {
          type = types.package;
          default = pkgs.wezterm;
          description = "Wezterm package to install.";
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          example = ''
            config.font = wezterm.font("JetBrains Mono")
            config.font_size = 12.0
            config.color_scheme = "Catppuccin Mocha"
            config.hide_tab_bar_if_only_one_tab = true
          '';
          description = ''
            Extra Lua code inserted into the wezterm configuration.
            The variables `wezterm` and `config` are already defined.
            The config table is returned automatically at the end.
          '';
        };
      };

      config = mkIf cfg.enable {
        packages = [ cfg.package ];

        file.".config/wezterm/wezterm.lua".text = weztermLuaContent;
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule weztermOpts);
  };
}
