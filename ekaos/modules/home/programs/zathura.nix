# Per-user zathura document viewer configuration
#
# Extends home.users.<name> with zathura-specific options.
# Generates ~/.config/zathura/zathurarc from settings, mappings,
# and extra configuration.
#
# Usage:
#   home.users.alice.programs.zathura = {
#     enable = true;
#     settings = {
#       default-bg = "#282828";
#       default-fg = "#ebdbb2";
#       recolor = true;
#       selection-clipboard = "clipboard";
#       font = "JetBrains Mono 10";
#     };
#     mappings = {
#       "D" = "toggle_page_mode";
#       "<C-r>" = "recolor";
#       "i" = "recolor";
#     };
#     extraConfig = ''
#       include catppuccin-mocha
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    concatStringsSep
    mapAttrsToList
    optional
    literalExpression
    ;

  # Convert a Nix value to zathura config format
  zathuraValue =
    v:
    if builtins.isBool v then
      (if v then "true" else "false")
    else if builtins.isString v then
      "\"${v}\""
    else
      toString v;

  zathuraOpts =
    { config, ... }:
    let
      cfg = config.programs.zathura;

      zathuraConfContent = concatStringsSep "\n" (
        [ "# Generated by ekaos home configuration. Do not edit." ]
        ++ [ "" ]

        # Settings: set key value
        ++ mapAttrsToList (name: value: "set ${name} ${zathuraValue value}") cfg.settings

        # Mappings: map key action
        ++ optional (cfg.settings != { } && cfg.mappings != { }) ""
        ++ mapAttrsToList (key: action: "map ${key} ${action}") cfg.mappings

        # Extra configuration
        ++ optional (cfg.extraConfig != "") ""
        ++ optional (cfg.extraConfig != "") cfg.extraConfig
      );
    in
    {
      options.programs.zathura = {
        enable = mkEnableOption "per-user zathura configuration";

        package = mkOption {
          type = types.package;
          default = pkgs.zathura;
          description = "Zathura package to install.";
        };

        settings = mkOption {
          type = types.attrsOf types.anything;
          default = { };
          example = literalExpression ''
            {
              default-bg = "#282828";
              default-fg = "#ebdbb2";
              recolor = true;
              selection-clipboard = "clipboard";
              font = "JetBrains Mono 10";
            }
          '';
          description = ''
            Zathura settings as attribute set.
            Each key-value pair is rendered as `set key value` in zathurarc.
            Booleans are converted to "true"/"false".
            Strings are automatically quoted.
          '';
        };

        mappings = mkOption {
          type = types.attrsOf types.str;
          default = { };
          example = literalExpression ''
            {
              "D" = "toggle_page_mode";
              "<C-r>" = "recolor";
            }
          '';
          description = ''
            Key mappings for zathura.
            Each key-value pair is rendered as `map key action` in zathurarc.
          '';
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          description = "Extra lines appended verbatim to zathurarc.";
        };
      };

      config = mkIf cfg.enable {
        packages = [ cfg.package ];

        file.".config/zathura/zathurarc".text = zathuraConfContent;
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule zathuraOpts);
  };
}
