# Per-user zsh configuration
#
# Extends home.users.<name> with zsh-specific options and composes
# .zshrc, .zprofile, and .zshenv from session variables, history
# settings, shell options, completion, and plugins.
#
# Usage:
#   home.users.alice.programs.zsh = {
#     enable = true;
#     shellOptions = [ "autocd" "extendedglob" "nomatch" ];
#     syntaxHighlighting.enable = true;
#     autosuggestions.enable = true;
#     initExtra = ''
#       eval "$(direnv hook zsh)"
#       bindkey '^R' history-incremental-search-backward
#     '';
#     profileExtra = ''
#       export GPG_TTY=$(tty)
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    concatStringsSep
    optional
    optionalString
    ;

  zshOpts =
    { config, ... }:
    let
      cfg = config.programs.zsh;

      # Compose the zshrc from all parts
      zshrcContent = concatStringsSep "\n" (
        [ "# Generated by ekaos home configuration. Do not edit." ]
        ++ [ "" ]

        # Source session variables from ekaos state dir
        ++ [
          ''
            # Source ekaos session variables (PATH, exports, aliases)
            if [ -f "$HOME/.config/ekaos/session-vars.sh" ]; then
              . "$HOME/.config/ekaos/session-vars.sh"
            fi
          ''
        ]

        # History settings
        ++ optional (cfg.historySize != null) "HISTSIZE=${toString cfg.historySize}"
        ++ optional (cfg.historySize != null) "SAVEHIST=${toString cfg.historySize}"
        ++ optional (cfg.historyFile != null) "HISTFILE=${cfg.historyFile}"

        # Shell options
        ++ map (opt: "setopt ${opt}") cfg.shellOptions

        # Completion initialization
        ++ optional (cfg.completionInit != "") cfg.completionInit

        # Syntax highlighting plugin
        ++ optional cfg.syntaxHighlighting.enable "source ${pkgs.zsh-syntax-highlighting}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

        # Autosuggestions plugin
        ++ optional cfg.autosuggestions.enable "source ${pkgs.zsh-autosuggestions}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

        # initExtra (arbitrary user zsh code)
        ++ optional (cfg.initExtra != "") cfg.initExtra
      );

      # Compose the zprofile
      profileContent = concatStringsSep "\n" (
        [ "# Generated by ekaos home configuration. Do not edit." ]
        ++ [ "" ]

        # Source .zshrc for login shells
        ++ [
          ''
            # Source .zshrc for login shells
            if [ -f "$HOME/.zshrc" ]; then
              . "$HOME/.zshrc"
            fi
          ''
        ]

        # profileExtra (login-only code)
        ++ optional (cfg.profileExtra != "") cfg.profileExtra
      );

      # Compose the zshenv
      envContent = concatStringsSep "\n" (
        [ "# Generated by ekaos home configuration. Do not edit." ]
        ++ [ "" ]
        ++ optional (cfg.envExtra != "") cfg.envExtra
      );
    in
    {
      options.programs.zsh = {
        enable = mkEnableOption "per-user zsh configuration";

        initExtra = mkOption {
          type = types.lines;
          default = "";
          example = ''
            eval "$(direnv hook zsh)"
            bindkey '^R' history-incremental-search-backward
          '';
          description = ''
            Extra commands to run in interactive zsh shells.
            Appended to .zshrc after session variables, history settings,
            and plugins.
          '';
        };

        profileExtra = mkOption {
          type = types.lines;
          default = "";
          example = ''
            export GPG_TTY=$(tty)
          '';
          description = ''
            Extra commands for login shells. Written to .zprofile
            after sourcing .zshrc.
          '';
        };

        envExtra = mkOption {
          type = types.lines;
          default = "";
          example = ''
            export ZDOTDIR=$HOME
          '';
          description = ''
            Extra commands for all zsh invocations. Written to .zshenv.
          '';
        };

        historySize = mkOption {
          type = types.nullOr types.int;
          default = 10000;
          description = "Number of history entries to keep (HISTSIZE and SAVEHIST).";
        };

        historyFile = mkOption {
          type = types.nullOr types.str;
          default = null;
          example = "$HOME/.zsh_history";
          description = "Path to the history file. Null uses the zsh default (~/.zsh_history).";
        };

        shellOptions = mkOption {
          type = types.listOf types.str;
          default = [ ];
          example = [
            "autocd"
            "extendedglob"
            "nomatch"
            "hist_ignore_dups"
          ];
          description = "Zsh options to enable via setopt.";
        };

        completionInit = mkOption {
          type = types.lines;
          default = "autoload -U compinit && compinit";
          description = "Completion system initialization commands.";
        };

        syntaxHighlighting.enable = mkOption {
          type = types.bool;
          default = false;
          description = "Whether to enable zsh-syntax-highlighting.";
        };

        autosuggestions.enable = mkOption {
          type = types.bool;
          default = false;
          description = "Whether to enable zsh-autosuggestions.";
        };
      };

      config = mkIf cfg.enable {
        file.".zshrc".text = zshrcContent;
        file.".zprofile".text = profileContent;
        file.".zshenv" = mkIf (cfg.envExtra != "") {
          text = envContent;
        };
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule zshOpts);
  };
}
