# Per-user mako notification daemon (Wayland)
#
# Extends home.users.<name> with mako options.
# Generates ~/.config/mako/config and a systemd user unit
# for the Wayland notification daemon (D-Bus activated).
#
# Usage:
#   home.users.alice.services.mako = {
#     enable = true;
#     settings = {
#       font = "monospace 10";
#       background-color = "#263238";
#       text-color = "#eceff1";
#       border-size = 2;
#       border-color = "#8be9fd";
#       default-timeout = 5000;
#       max-visible = 5;
#     };
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    concatStringsSep
    mapAttrsToList
    literalExpression
    ;

  makoOpts =
    { config, ... }:
    let
      cfg = config.services.mako;

      # Mako uses a simple key=value config format, one per line
      configContent = concatStringsSep "\n" (
        [ "# Generated by ekaos home configuration. Do not edit." ]
        ++ mapAttrsToList (k: v: "${k}=${toString v}") cfg.settings
        ++ (if cfg.extraConfig != "" then [ cfg.extraConfig ] else [ ])
        ++ [ "" ]
      );
    in
    {
      options.services.mako = {
        enable = mkEnableOption "mako Wayland notification daemon";

        package = mkOption {
          type = types.package;
          default = pkgs.mako;
          defaultText = literalExpression "pkgs.mako";
          description = "The mako package to use.";
        };

        settings = mkOption {
          type = types.attrsOf types.anything;
          default = { };
          description = ''
            Configuration for mako as key-value pairs.
            Each attribute becomes a line in the config file as key=value.
            See mako(5) for available options.
          '';
          example = literalExpression ''
            {
              font = "monospace 10";
              background-color = "#263238";
              default-timeout = 5000;
            }
          '';
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          description = "Additional lines appended to the mako config file.";
        };
      };

      config = mkIf cfg.enable {
        packages = [ cfg.package ];

        file.".config/mako/config".text = configContent;

        file.".config/systemd/user/mako.service".text = ''
          [Unit]
          Description=Mako Wayland notification daemon
          Documentation=man:mako(1)
          After=graphical-session.target
          PartOf=graphical-session.target

          [Service]
          Type=dbus
          BusName=org.freedesktop.Notifications
          ExecStart=${cfg.package}/bin/mako
          Restart=on-failure

          [Install]
          WantedBy=graphical-session.target
        '';
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule makoOpts);
  };
}
