# Per-user MPD (Music Player Daemon) configuration
#
# Extends home.users.<name> with MPD options.
# Generates ~/.config/mpd/mpd.conf and a systemd user unit
# for running MPD in user mode with sd_notify support.
#
# Usage:
#   home.users.alice.services.mpd = {
#     enable = true;
#     musicDirectory = "~/Music";
#     dataDir = "~/.local/share/mpd";
#     network.listenAddress = "127.0.0.1";
#     network.port = 6600;
#     extraConfig = ''
#       audio_output {
#         type "pipewire"
#         name "PipeWire Sound Server"
#       }
#     '';
#   };
{ lib, pkgs, ... }:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    types
    optionalString
    concatStringsSep
    literalExpression
    ;

  mpdOpts =
    { config, ... }:
    let
      cfg = config.services.mpd;

      # MPD uses a custom config format: key "value" per line
      mpdConfContent = concatStringsSep "\n" (
        [
          "# Generated by ekaos home configuration. Do not edit."
          "music_directory \"${cfg.musicDirectory}\""
          "db_file \"${cfg.dataDir}/database\""
          "state_file \"${cfg.dataDir}/state\""
          "sticker_file \"${cfg.dataDir}/sticker.sql\""
          "playlist_directory \"${cfg.dataDir}/playlists\""
          "bind_to_address \"${cfg.network.listenAddress}\""
          "port \"${toString cfg.network.port}\""
        ]
        ++ (
          if cfg.extraConfig != "" then
            [
              ""
              cfg.extraConfig
            ]
          else
            [ ]
        )
        ++ [ "" ]
      );
    in
    {
      options.services.mpd = {
        enable = mkEnableOption "MPD (Music Player Daemon) user service";

        package = mkOption {
          type = types.package;
          default = pkgs.mpd;
          defaultText = literalExpression "pkgs.mpd";
          description = "The MPD package to use.";
        };

        musicDirectory = mkOption {
          type = types.str;
          default = "~/Music";
          description = "Path to the music directory.";
        };

        dataDir = mkOption {
          type = types.str;
          default = "~/.local/share/mpd";
          description = ''
            Path to the MPD data directory.
            Used for the database, state file, sticker database,
            and playlist directory.
          '';
        };

        network = {
          listenAddress = mkOption {
            type = types.str;
            default = "127.0.0.1";
            description = "Address MPD listens on.";
          };

          port = mkOption {
            type = types.int;
            default = 6600;
            description = "Port MPD listens on.";
          };
        };

        extraConfig = mkOption {
          type = types.lines;
          default = "";
          description = ''
            Additional configuration appended to mpd.conf.
            Useful for audio output blocks and other advanced settings.
          '';
          example = literalExpression ''
            '''
              audio_output {
                type "pipewire"
                name "PipeWire Sound Server"
              }
            '''
          '';
        };
      };

      config = mkIf cfg.enable {
        packages = [ cfg.package ];

        file.".config/mpd/mpd.conf".text = mpdConfContent;

        file.".config/systemd/user/mpd.service".text = ''
          [Unit]
          Description=Music Player Daemon
          Documentation=man:mpd(1) man:mpd.conf(5)
          After=network.target sound.target

          [Service]
          Type=notify
          ExecStart=${cfg.package}/bin/mpd --no-daemon
          Restart=on-failure
          WatchdogSec=120

          [Install]
          WantedBy=default.target
        '';
      };
    };
in

{
  options.home.users = mkOption {
    type = types.attrsOf (types.submodule mpdOpts);
  };
}
