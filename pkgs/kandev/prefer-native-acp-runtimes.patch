-		return agents.Command{}, fmt.Errorf("resolve active managed runtime version for %s: %w", agentType, err)
+	if preferNative {
+		return ag.BuildCommand(agents.CommandOptions{
+			Runtime:            agentruntime.RuntimeStandalone,
+			PreferNativeBinary: true,
