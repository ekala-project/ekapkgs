From 9cc071d06b97e20aee3841c2eaa8078c6ed396d7 Mon Sep 17 00:00:00 2001
From: Marcin Serwin <marcin@serwin.dev>
Date: Mon, 28 Jul 2025 09:21:54 +0200
Subject: [PATCH] Add support for cross-compilation (#68)

Rebased onto 1.38 release.

Signed-off-by: Marcin Serwin <marcin@serwin.dev>
---
 makefile              | 20 ++++++++++++++++----
 src/pak_creator.c     |  8 +++++++-
 src/structs.h         |  7 +------
 src/system/pak_data.h | 23 +++++++++++++++++++++++
 4 files changed, 47 insertions(+), 11 deletions(-)
 create mode 100644 src/system/pak_data.h

diff --git a/makefile b/makefile
index 98cba969d..6214be142 100644
--- a/makefile
+++ b/makefile
@@ -7,6 +7,13 @@ MAN = man/
 UNIX = 1
 MACOS = 0

+PKG_CONFIG ?= pkg-config
+
+BUILD_CC := $(CC)
+BUILD_CFLAGS := $(CFLAGS)
+BUILD_LDFLAGS := $(LDFLAGS)
+BUILD_PKG_CONFIG := $(PKG_CONFIG)
+
 ifeq ($(UNIX),0)
 PROG      = edgar.exe
 ED_PROG   = mapeditor.exe
@@ -38,7 +45,8 @@ else
 DATA_DIR = $(PREFIX)/share/games/edgar/
 endif

-CFLAGS += `sdl2-config --cflags` -Wall -pedantic
+CFLAGS += `$(PKG_CONFIG) --cflags sdl2 SDL2_mixer SDL2_image SDL2_ttf zlib libpng` -Wall -pedantic
+BUILD_CFLAGS += `$(BUILD_PKG_CONFIG) --cflags zlib`
 ifeq ($(DEV),1)
 CFLAGS += -Werror -g
 else
@@ -50,7 +58,8 @@ ifndef NO_PAK
 DEFINES += -DPAK_FILE=\"$(PAK_FILE)\"
 endif

-LDFLAGS += `sdl2-config --libs` -lSDL2_mixer -lSDL2_image -lSDL2_ttf -lz -lm -lpng
+LDFLAGS += `$(PKG_CONFIG) --libs sdl2 SDL2_mixer SDL2_image SDL2_ttf zlib libpng` -lm
+BUILD_LDFLAGS += `$(BUILD_PKG_CONFIG) --libs zlib`

 _TILE_OBJS  = tile_creator.o
 _PAK_OBJS   = pak_creator.o
@@ -119,8 +128,11 @@ makefile.dep : src/*/*.h src/*.h
 	sed -i -E 's/^(.+:)/obj\/\1/g' $@

 # compiling other source files.
-$(MAIN_OBJS) $(CORE_OBJS) $(EDIT_OBJS) $(PAK_OBJS) $(PO_OBJS) $(TILE_OBJS):
-	$(CC) $(CFLAGS) $(DEFINES) -c -o $@ $<
+$(MAIN_OBJS) $(CORE_OBJS) $(EDIT_OBJS) $(PO_OBJS) $(TILE_OBJS):
+	$(CC) $(CFLAGS) $(DEFINES) -c -o $@ $<
+
+$(PAK_OBJS):
+	$(BUILD_CC) $(BUILD_CFLAGS) $(DEFINES) -c -o $@ $<

 %.mo: %.po
 	msgfmt -c -o $@ $<
@@ -134,7 +146,7 @@ $(ED_PROG): $(EDIT_OBJS) $(CORE_OBJS)

 # linking the program.
 $(PAK_PROG): $(PAK_OBJS)
-	$(CC) $(PAK_OBJS) -o $(PAK_PROG) $(LDFLAGS)
+	$(BUILD_CC) $(PAK_OBJS) -o $(PAK_PROG) $(BUILD_LDFLAGS)

 # linking the program.
 $(PO_PROG): $(PO_OBJS)
diff --git a/src/pak_creator.c b/src/pak_creator.c
index a42d0ab42..4eb0473d4 100644
--- a/src/pak_creator.c
+++ b/src/pak_creator.c
@@ -17,7 +17,13 @@ along with this program; if not, write to the Free Software
 Foundation, 51 Franklin Street, Suite 500, Boston, MA 02110-1335, USA.
 */

-#include "headers.h"
+#include <dirent.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <zlib.h>
+#include "defs.h"
+#include "system/pak_data.h"

 FILE *pak;
 int fileID;
diff --git a/src/structs.h b/src/structs.h
index f9a71c0ec..abd65991c 100644
--- a/src/structs.h
+++ b/src/structs.h
@@ -18,6 +18,7 @@ Foundation, 51 Franklin Street, Suite 500, Boston, MA 02110-1335, USA.
 */

 #include "defs.h"
+#include "system/pak_data.h"

 typedef struct Texture
 {
@@ -334,12 +335,6 @@ typedef struct Grid
 	struct Grid *next;
 } Grid;

-typedef struct FileData
-{
-	char filename[MAX_FILE_LENGTH];
-	int32_t fileSize, compressedSize, offset;
-} FileData;
-
 typedef struct ContinueData
 {
 	char boss[MAX_VALUE_LENGTH];
diff --git a/src/system/pak_data.h b/src/system/pak_data.h
new file mode 100644
index 000000000..dfb724f84
--- /dev/null
+++ b/src/system/pak_data.h
@@ -0,0 +1,23 @@
